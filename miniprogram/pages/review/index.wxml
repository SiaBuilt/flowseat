<view class="page">
  <view class="title">待处理</view>
  <view class="notice">V0.1 只读取待处理队列，实际审核动作在共创版本接入。</view>
  <view wx:if="{{loading}}" class="muted">正在读取…</view>
  <view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重试</button></view>
  <view wx:if="{{!loading &amp;&amp; !error &amp;&amp; items.length === 0}}" class="card muted">目前没有待处理记录。</view>
  <view wx:for="{{items}}" wx:key="id" class="card"><view class="name">{{item.kind}}</view><view class="muted">{{item.summary}}</view></view>
</view>
