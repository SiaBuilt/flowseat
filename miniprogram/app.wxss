page { background: #f5f3ee; color: #252f28; font-family: -apple-system, sans-serif; }
.page { padding: 32rpx; }
.eyebrow { color: #647367; font-size: 24rpx; }
.title { font-size: 48rpx; font-weight: 600; margin: 12rpx 0 20rpx; }
.subtitle { color: #657065; font-size: 28rpx; line-height: 1.7; }
.notice { padding: 20rpx 24rpx; background: #ece7d6; border-radius: 16rpx; font-size: 24rpx; margin-bottom: 24rpx; }
.card { background: #fff; border-radius: 24rpx; padding: 28rpx; margin-top: 24rpx; }
.name { font-size: 32rpx; font-weight: 600; margin-bottom: 16rpx; }
.row { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; }
.muted { color: #68736b; font-size: 26rpx; line-height: 1.7; }
.error { color: #944237; font-size: 26rpx; margin-top: 24rpx; }
.empty { padding: 40rpx 0; }
button { font-size: 28rpx; border-radius: 16rpx; margin-top: 24rpx; }
.primary { background: #285943; color: #fff; }
.tabs { display: flex; gap: 16rpx; margin: 28rpx 0; }
.tab { padding: 14rpx 28rpx; border-radius: 30rpx; background: #e7e9e1; }
.active { color: #fff; background: #285943; }
map { width: 100%; height: 600rpx; border-radius: 24rpx; }
